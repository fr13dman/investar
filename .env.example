# Copy to .env (repo root or backend/) and fill in.

# Finnhub free key (https://finnhub.io/register): live quotes + company news. 60 calls/min.
FINNHUB_API_KEY=

# PatentsView PatentSearch key (request via the PatentsView Help Center). 45 requests/min.
PATENTSVIEW_API_KEY=

# Required by SEC EDGAR's fair-access policy: your name/app and a contact email.
SEC_USER_AGENT="Investar research app you@example.com"

# Local SQLite database (relative paths resolve from the backend/ directory).
DATABASE_URL=sqlite:///data/investar.db

# Sentiment model: auto (FinBERT if installed, else VADER) | finbert | vader
SENTIMENT_MODEL=auto

# Set to false to disable the 15-minute price refresh and weekly research jobs.
ENABLE_SCHEDULER=true
